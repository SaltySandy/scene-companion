# Gemini Live wall detector. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# SAW_GEMINI_LIVE_MODEL=gemini-3.8-live
# SAW_WALL_INTERVAL_SEC=1.0        # seconds between checks (Live API max is 1 frame/s)
# SAW_WALL_ALERT_COOLDOWN=2.5      # seconds between repeated "back up" alerts
# SAW_WALL_CONFIRM=1               # consecutive too_close verdicts before alerting
# SAW_WALL_SPEAK_APPROACH=1        # also say "Wall ahead, slow down" at 1-3 m
# SAW_WALL_DETECTOR=0              # turn the detector off

# Optional. Leave unset and the laptop server runs exactly as before.
# Copy to .env and fill in. Do not commit .env.

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Use this instead of SNOWFLAKE_PASSWORD for key-pair auth.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
# Optional. Defaults to llama3.1-8b.
# SNOWFLAKE_CORTEX_MODEL=llama3.1-8b

# Speech-to-text model. CPU int8. First download of base.en is about 150 MB.
# WHISPER_MODEL=base.en

# TigerData (Timescale). A postgres connection string.
# TIGER_DATABASE_URL=postgresql://user:password@host:5432/tsdb?sslmode=require
TIGER_DATABASE_URL=
