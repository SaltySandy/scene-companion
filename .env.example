# Gemini: answers "What is this?" about the camera view (and speech-to-text on Python
# versions without faster-whisper). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional backup: Gemini Live wall detector. Off by default; the depth model is the
# proximity sensor. Turn on only if the depth model can't run on this laptop.
# SAW_WALL_DETECTOR=1
# SAW_GEMINI_LIVE_MODEL=gemini-3.8-live

# "What is this?" voice questions. Gemini looks at the frame; Nimble adds live web facts.
# Get a Nimble key at https://www.nimbleway.com
NIMBLE_API_KEY=
# SAW_GEMINI_VISION_MODEL=gemini-3.5-flash-lite   # gemini-3.8-flash is smarter but slower
# SAW_NIMBLE_MAX_RESULTS=5
# SAW_STT_BACKEND=auto             # whisper | gemini. auto uses whisper if installed, else Gemini
# SAW_ASSISTANT=0                  # turn voice questions off

# Optional. Leave unset and the laptop server runs exactly as before.
# Copy to .env and fill in. Do not commit .env.

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Use this instead of SNOWFLAKE_PASSWORD for key-pair auth.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
# Optional. Defaults to llama3.1-8b.
# SNOWFLAKE_CORTEX_MODEL=llama3.1-8b

# Speech-to-text model. CPU int8. First download of base.en is about 150 MB.
# WHISPER_MODEL=base.en

# TigerData (Timescale). A postgres connection string.
# TIGER_DATABASE_URL=postgresql://user:password@host:5432/tsdb?sslmode=require
TIGER_DATABASE_URL=
