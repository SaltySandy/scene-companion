# Optional. Leave unset and the laptop server runs exactly as before.
# Copy to .env and fill in. Do not commit .env.

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Use this instead of SNOWFLAKE_PASSWORD for key-pair auth.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
# Optional. Defaults to llama3.1-8b.
# SNOWFLAKE_CORTEX_MODEL=llama3.1-8b

# TigerData (Timescale). A postgres connection string.
# TIGER_DATABASE_URL=postgresql://user:password@host:5432/tsdb?sslmode=require
TIGER_DATABASE_URL=

# Proximity warning (deterministic, no model download)
# SAW_PROXIMITY_ENABLED=1
# SAW_PROXIMITY_THRESHOLD_M=0.3
# SAW_PROXIMITY_HYSTERESIS_M=0.35
# SAW_PROXIMITY_COOLDOWN_MS=2000
# SAW_PROXIMITY_STALE_MS=800
# SAW_PROXIMITY_OBJECT_WIDTH_M=0.6
# SAW_PROXIMITY_ESTIMATOR=corridor_looming
# SAW_DEFAULT_REMAINING_MS=250
# SAW_FLASH_BRIGHTNESS=200
