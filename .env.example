# Optional. Leave unset and the laptop server runs exactly as before.
# Copy to .env and fill in. Do not commit .env.

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Use this instead of SNOWFLAKE_PASSWORD for key-pair auth.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
# Optional. Defaults to llama3.1-8b.
# SNOWFLAKE_CORTEX_MODEL=llama3.1-8b

# Speech-to-text model. CPU int8. First download of base.en is about 150 MB.
# WHISPER_MODEL=base.en

# TigerData (Timescale). A postgres connection string.
# TIGER_DATABASE_URL=postgresql://user:password@host:5432/tsdb?sslmode=require
TIGER_DATABASE_URL=
