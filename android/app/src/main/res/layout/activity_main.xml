<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/sentry_title_cd"
        android:text="@string/app_name"
        android:textColor="@color/accent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="assertive"
        android:contentDescription="@string/status_cd"
        android:focusable="true"
        android:text="@string/status_stopped"
        android:textColor="@color/ink"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/startStop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:backgroundTint="@color/accent"
        android:contentDescription="@string/start_streaming_cd"
        android:minHeight="200dp"
        android:text="@string/start_streaming"
        android:textAllCaps="false"
        android:textColor="@color/on_accent"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:labelFor="@+id/hostInput"
        android:text="@string/server_label"
        android:textColor="@color/muted"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/hostInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="username"
        android:background="@drawable/field_bg"
        android:contentDescription="@string/server_cd"
        android:hint="@string/server_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:minHeight="56dp"
        android:padding="12dp"
        android:text="@string/server_hint"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/micLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:labelFor="@+id/micToggle"
            android:text="@string/mic_label"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/micToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/mic_cd"
            android:minWidth="48dp"
            android:minHeight="48dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/hint_usb"
        android:textColor="@color/muted"
        android:textSize="14sp" />
</LinearLayout>
